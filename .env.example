# Copy to .env and fill in. Never commit the real file.

# OAuth client credentials from Genesys Cloud > Admin > Integrations > OAuth
# Grant type must be "Client Credentials".
GENESYS_CLIENT_ID=PUT_YOUR_CLIENT_ID_HERE
GENESYS_CLIENT_SECRET=PUT_YOUR_CLIENT_SECRET_HERE

# Region domain. Your org is on the Ireland (eu-west-1) region.
GENESYS_REGION=mypurecloud.ie

# Only needed for --narrate (the optional AI-written prose pass)
ANTHROPIC_API_KEY=
